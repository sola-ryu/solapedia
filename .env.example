# Copy to .env and adjust. All optional — see astro.config.mjs for defaults.

# Deployment target for astro.config.mjs's `site`/`base`. If unset:
#   - SSR mode defaults to no subpath (site unset, base "/") — self-hosted
#     at a domain root.
#   - the static build defaults to the GitHub Pages project subpath
#     (site "https://sola-ryu.github.io", base "/solapedia/").
# SITE=https://example.com
# BASE=/

# LLM article generation (SSR mode only — see src/lib/article-generator.ts).
# OPENAI_API_KEY is required for generation to work; the others are optional.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Point at a local OpenAI-compatible server (e.g. LM Studio) instead of the
# real OpenAI API, to test generation for free:
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
