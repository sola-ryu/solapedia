---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allArticles = await getCollection('articles');

function firstParagraph(body: string): string {
	const paragraph = body
		.split(/\n\s*\n/)
		.map((block) => block.trim())
		.find((block) => block && !block.startsWith('#') && !block.startsWith('!['));
	if (!paragraph) return '';
	return paragraph
		.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
		.replace(/[*_`>#]/g, '')
		.replace(/\s+/g, ' ')
		.trim();
}

function summarize(article: (typeof allArticles)[number]): string {
	return article.data.description || firstParagraph(article.body ?? '');
}

function truncate(text: string, max: number): string {
	if (text.length <= max) return text;
	return `${text.slice(0, max).trimEnd()}…`;
}

const recent = [...allArticles]
	.filter((a) => a.data.featured)
	.sort((a, b) => (b.data.updated?.getTime() ?? 0) - (a.data.updated?.getTime() ?? 0))
	.slice(0, 40);

// Shuffle recent articles
for (let i = recent.length - 1; i > 0; i--) {
	const j = Math.floor(Math.random() * (i + 1));
	[recent[i], recent[j]] = [recent[j], recent[i]];
}

const featuredArticles = allArticles.filter((a) => a.data.featured);
const featured = featuredArticles.length
	? featuredArticles[Math.floor(Math.random() * featuredArticles.length)]
	: null;
const featuredSummary = featured ? summarize(featured) : '';
const base = import.meta.env.BASE_URL;
---

<Layout description="A small encyclopedia that you can definitely trust, I promise.">
	<header class="welcome">
		<h1>Welcome to Solapedia</h1>
		<p>Solapedia is a small encyclopedia where every article is not written. Use the search box above to find something specific.</p>
	</header>

	{featured && (
		<section class="featured">
			<h2>Featured article</h2>
			<div class="featured-card">
				<div class="featured-content">
					<a class="featured-title" href={`${base}wiki/${featured.id}`}>{featured.data.title}</a>
					{featuredSummary && <p class="featured-desc">{truncate(featuredSummary, 500)}</p>}
					<a class="read-more" href={`${base}wiki/${featured.id}`}>Read more →</a>
				</div>
			</div>
		</section>
	)}

	<section class="recent">
		<h2>Recently updated</h2>
		<div class="article-grid">
			{
				recent.slice(0, 20).map((article) => {
					const text = summarize(article);
					return (
						<a class="article-card" href={`${base}wiki/${article.id}`}>
							<h3>{article.data.title}</h3>
							{text && <p class="summary">{truncate(text, 150)}</p>}
						</a>
					);
				})
			}
		</div>
	</section>
</Layout>

<style>
	.welcome {
		text-align: center;
		margin-bottom: 2rem;
	}

	.welcome h1 {
		font-size: 2.2rem;
		margin-bottom: 0.5rem;
	}

	.welcome p {
		color: var(--muted);
		font-family: system-ui, sans-serif;
		max-width: 500px;
		margin: 0 auto;
	}

	h2 {
		font-size: 1.3rem;
		border-bottom: 1px solid var(--border);
		padding-bottom: 0.3rem;
		margin-bottom: 1rem;
	}

	.featured-card {
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 1.25rem 1.5rem;
		background: var(--header-bg);
		margin-bottom: 2.5rem;
	}

	.featured-title {
		font-size: 1.35rem;
		font-weight: bold;
		text-decoration: none;
	}

	.featured-title:hover {
		text-decoration: underline;
	}

	.featured-desc {
		margin: 0.6rem 0;
		line-height: 1.5;
	}

	.read-more {
		font-family: system-ui, sans-serif;
		font-size: 0.85rem;
	}

	.article-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1rem;
	}

	.article-card {
		display: block;
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 1rem 1.25rem;
		background: var(--header-bg);
		text-decoration: none;
		transition: border-color 0.15s ease;
	}

	.article-card:hover {
		border-color: var(--link);
	}

	.article-card h3 {
		font-size: 1.05rem;
		margin: 0 0 0.4rem;
	}

	.article-card p {
		margin: 0;
		color: var(--muted);
		font-family: system-ui, sans-serif;
		font-size: 0.9rem;
		line-height: 1.45;
	}
</style>
