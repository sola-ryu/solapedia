---
// SSR-only: "suggest an edit" form for an existing article. Injected at
// /edit/[slug] — see astro.config.mjs. Unlike /wiki/[...slug], this has no
// static counterpart to collide with, so a plain (non-rest) param is fine.
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { articlesDir, safeSlug, suggestArticleEdit } from '../lib/article-generator';
import { readFile } from 'node:fs/promises';
import path from 'node:path';

const slug = safeSlug(decodeURIComponent(Astro.params.slug ?? ''));

let currentTitle: string | null = null;
let notFound = false;
if (slug) {
	try {
		const raw = await readFile(path.join(articlesDir, `${slug}.md`.toLowerCase()), 'utf-8');
		currentTitle = raw.match(/title:\s*(.+)/)?.[1]?.trim().replace(/^"|"$/g, '') ?? slug;
	} catch {
		notFound = true;
	}
} else {
	notFound = true;
}

if (notFound) Astro.response.status = 404;

let error = '';
let done = false;
let change = '';

if (slug && !notFound && Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	change = (form.get('change') ?? '').toString().trim();

	if (!change) {
		error = 'Describe the change you want first.';
	} else {
		try {
			const updated = await suggestArticleEdit(slug, change);
			currentTitle = updated.title;
			done = true;
			change = '';
		} catch (e) {
			error = e instanceof Error ? e.message : 'Could not apply the edit.';
		}
	}
}
---

<Layout title={currentTitle ? `Suggest edit — ${currentTitle}` : 'Suggest edit'}>
	{
		notFound ? (
			<>
				<h1>Article not found</h1>
				<p>
					<a href={import.meta.env.BASE_URL}>Return home</a>
				</p>
			</>
		) : (
			<>
				<h1>Suggest an edit — {currentTitle}</h1>
				<p class="hint">
					Describe what should change. The whole article is regenerated by the model with your
					change applied, then saved in place. In <code>astro dev</code> the update appears at
					its <code>/wiki/{slug}</code> page immediately; in a built SSR server, restart or
					rebuild to pick it up.
				</p>

				{done && (
					<p class="success">
						Edit applied. <a href={`${import.meta.env.BASE_URL}wiki/${slug}`}>View "{currentTitle}"</a>
					</p>
				)}
				{error && <p class="error">{error}</p>}

				<form method="POST">
					<label>
						What would you like changed?
						<textarea name="change" rows="6" required>{change}</textarea>
					</label>
					<button type="submit">Suggest edit</button>
				</form>
			</>
		)
	}
</Layout>

<style>
	.hint {
		font-family: system-ui, sans-serif;
		font-size: 0.85rem;
		color: var(--muted);
	}

	.success {
		font-family: system-ui, sans-serif;
		background: var(--header-bg);
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 0.6rem 0.8rem;
	}

	.error {
		font-family: system-ui, sans-serif;
		color: #b00;
		border: 1px solid #b00;
		border-radius: 4px;
		padding: 0.6rem 0.8rem;
	}

	form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 640px;
	}

	label {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-family: system-ui, sans-serif;
		font-weight: bold;
	}

	textarea {
		font-family: inherit;
		font-weight: normal;
		font-size: 1rem;
		padding: 0.5rem;
		border: 1px solid var(--border);
		border-radius: 4px;
		background: var(--bg);
		color: var(--fg);
		resize: vertical;
	}

	button {
		align-self: flex-start;
		font-size: 1rem;
		padding: 0.5rem 1.2rem;
		border: 1px solid var(--border);
		border-radius: 4px;
		background: var(--header-bg);
		color: var(--fg);
		cursor: pointer;
	}

	button:hover {
		background: var(--border);
	}
</style>
